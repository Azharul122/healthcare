<div style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f7fb;padding:40px 15px;">
        <tr>
            <td align="center">

                <!-- Email Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px;background:#ffffff;border-radius:16px;overflow:hidden;
                           box-shadow:0 8px 30px rgba(0,0,0,0.08);">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding:30px 30px 20px;">
                            <!-- Company Logo -->
                            <img src="https://cdn.dribbble.com/userupload/44970967/file/bb19b75c7489d8dadb8b1b709bb8ee65.png?resize=400x0"
                                alt="Company Logo" width="140"
                                style="display:block;max-width:140px;height:auto;border:0;">

                            <div style="height:20px;"></div>

                            <h2 style="margin:0;color:#172033;font-size:24px;font-weight:700;">
                                Verify Your Account
                            </h2>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:10px 40px 35px;text-align:center;">

                            <p style="margin:0 0 12px;color:#4b5563;font-size:16px;line-height:26px;">
                                Hello <strong style="color:#172033;">
                                    <%= name %>
                                </strong>,
                            </p>

                            <p style="margin:0 0 25px;color:#6b7280;font-size:15px;line-height:24px;">
                                Use the verification code below to continue.
                            </p>

                            <!-- OTP -->
                            <div style="display:inline-block;background:#f1f5ff;border:1px solid #dbe4ff;
                                        border-radius:12px;padding:18px 35px;margin:5px 0 22px;">
                                <span style="font-size:32px;letter-spacing:8px;font-weight:700;
                                             color:#2563eb;">
                                    <%= otp %>
                                </span>
                            </div>

                            <p style="margin:0;color:#6b7280;font-size:14px;line-height:22px;">
                                This OTP is valid for
                                <strong style="color:#172033;">10 minutes</strong>.
                            </p>

                            <p style="margin:22px 0 0;color:#9ca3af;font-size:12px;line-height:20px;">
                                If you didn't request this code, you can safely ignore this email.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background:#f8fafc;padding:20px 30px;text-align:center;
                                   border-top:1px solid #eef1f5;">

                            <p style="margin:0;color:#9ca3af;font-size:12px;line-height:20px;">
                                © 2026 Your Company. All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</div>